# Base de datos (local)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/saas_ecommerce

# Redis
REDIS_URL=redis://localhost:6379

# Autenticación - Generar con: openssl rand -base64 32
AUTH_SECRET=cambia_esto_por_un_secreto_aleatorio
# NEXTAUTH_URL es opcional: NextAuth v5 la infiere automáticamente del Host header de cada app

# MinIO (cambiar por tus access keys)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=tu_access_key
MINIO_SECRET_KEY=tu_secret_key
MINIO_BUCKET=saas-media
MINIO_USE_SSL=false

# Email (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@saas.local

# MercadoPago
# Obtén tus credenciales en https://www.mercadopago.com/developers/panel
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx
# true for sandbox (test mode), false for production
MP_USE_SANDBOX=true
# Get from MP Developer Dashboard > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here
# Set to true to bypass signature verification in development
BYPASS_WEBHOOK_SIGNATURE=true

# Public URL for MercadoPago back_urls (e.g., ngrok, cloudflare tunnel, production domain)
STOREFRONT_URL=https://your-domain.com

# --- Servicios Cloud (Producción) ---
# ⚠️ IMPORTANTE: En producción (NODE_ENV=production), todas las variables
# de esta sección son obligatorias. La app no arrancará si faltan.
# Ver packages/validation/src/env.ts para el esquema de validación.

# Neon (PostgreSQL)
# DATABASE_URL=postgresql://user:pass@endpoint/db?sslmode=require

# Upstash (Redis)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=tu_token

# Cloudflare R2 (Storage)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=tu_access_key
# R2_SECRET_ACCESS_KEY=tu_secret_key
# R2_BUCKET_NAME=saas-media-prod

# Resend (Email)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# MercadoPago (Producción - usa la misma variable que en desarrollo)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxx
# MP_WEBHOOK_SECRET=tu_secret

# Sentry (Monitoreo de Errores) - opcional, solo para producción
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=tu-org
# SENTRY_PROJECT=saas-storefront
# SENTRY_AUTH_TOKEN=tu-token