# ─── Base de datos ───
# Neon (PostgreSQL en la nube). Usar DATABASE_URL de tu proyecto Neon.
DATABASE_URL=postgresql://user:pass@endpoint/db?sslmode=require

# ─── Redis ───
# Upstash: usar la URL de Redis Protocol (ioredis compatible)
# Formato: rediss://default:<token>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:token@xxxx.upstash.io:6379

# ─── Autenticación ───
# Generar con: openssl rand -base64 32
AUTH_SECRET=cambia_esto_por_un_secreto_aleatorio
# NEXTAUTH_URL es opcional: NextAuth v5 la infiere automáticamente del Host header

# ─── Storage (R2 / Cloudflare) ───
# Reemplaza a MinIO local. Usa el cliente S3-compatible de MinIO contra R2.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret_key
R2_BUCKET_NAME=saas-media-prod

# ─── Email (Resend) ───
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=noreply@tudominio.com

# ─── MercadoPago ───
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxx
# true for sandbox (test mode), false for production
MP_USE_SANDBOX=false
# Get from MP Developer Dashboard > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret
# Set to true to bypass signature verification in development
BYPASS_WEBHOOK_SIGNATURE=true

# ─── URLs públicas ───
# Para webhooks de MercadoPago (back_urls)
STOREFRONT_URL=https://tu-dominio-storefront.vercel.app

# ─── Sentry (Monitoreo de Errores) ───
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=tu-org
SENTRY_PROJECT=saas-storefront
SENTRY_AUTH_TOKEN=tu-token

# ─── Upstash REST (cache de sesiones, colas) ───
# Requerido por la validación de producción. Opcional si REDIS_URL ya funciona.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token

# ─── Supabase (solo si se usa, opcional) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
