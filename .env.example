DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_db
REDIS_URL=redis://localhost:6379
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=cambiar-por-un-secret-seguro-en-produccion
# Generar con: openssl rand -base64 32
AUTH_SECRET=cambiar-por-un-secret-seguro-en-produccion
# NEXTAUTH_URL es opcional: NextAuth v5 la infiere automáticamente del Host header.
# Si necesitas forzarla (ej. proxy inverso), descomentá:
# NEXTAUTH_URL=https://tu-dominio.com
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=tu_access_key
MINIO_SECRET_KEY=tu_secret_key
MINIO_BUCKET=saas-images
MINIO_USE_SSL=false

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx

# --- Servicios Cloud (Producción) ---
# ⚠️ IMPORTANTE: En producción (NODE_ENV=production), todas las variables
# de esta sección son obligatorias. La app no arrancará si faltan.
# Ver packages/validation/src/env.ts para el esquema de validación.

# Neon (PostgreSQL)
# DATABASE_URL=postgresql://user:pass@endpoint/db?sslmode=require

# Upstash (Redis)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=tu_token

# Cloudflare R2 (Storage)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=tu_access_key
# R2_SECRET_ACCESS_KEY=tu_secret_key
# R2_BUCKET_NAME=saas-media-prod

# Resend (Email)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# MercadoPago (Producción - usa la misma variable que en desarrollo)
# MERCADOPAGO_WEBHOOK_SECRET=tu_secret

# Sentry (Monitoreo de Errores) - opcional en producción
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=tu-org
# SENTRY_PROJECT=saas-storefront
# SENTRY_AUTH_TOKEN=tu-token
